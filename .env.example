# INTEMA ERP/MES v2 - configuracion de ejemplo
# Copiar como .env y cambiar los valores antes de usar en produccion.

APP_NAME="INTEMA ERP/MES"
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intema_erp
POSTGRES_USER=intema_app
POSTGRES_PASSWORD=cambiar_esta_clave
DATABASE_URL=postgresql+psycopg://intema_app:cambiar_esta_clave@localhost:5432/intema_erp

JWT_SECRET_KEY=cambiar_por_un_valor_largo_y_aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=720

ADMIN_FULL_NAME=Administrador INTEMA
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@intema.local
ADMIN_PASSWORD=Cambiar123!